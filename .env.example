ACTUAL_PASSWORD=
# Only required for E2EE budgets (production). Leave unset for plaintext dev budget.
ACTUAL_ENCRYPTION_PASSWORD=

# LLM API keys — only needed for cloud providers (OpenRouter, Gemini, OpenAI, etc.)
# Leave unset for local llama.cpp servers that don't require authentication.
LLM_API_KEY=
# Optional: separate key for the vision model when [llm.vision] uses a different provider.
# Falls back to LLM_API_KEY when unset.
# LLM_VISION_API_KEY=

# Receipt ingestion (only required if [receipts] enabled = true)
IMAP_PASSWORD=
RECEIPT_RECEIVER_TOKEN=
